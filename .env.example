API_PORT=8500
WEB_PORT=8503

POSTGRES_DB=events
POSTGRES_USER=events
POSTGRES_PASSWORD=events
POSTGRES_PORT=8502

REDIS_PORT=8501

# Routing (GraphHopper). See apps/backend/graphhopper/README.md
GRAPHHOPPER_PORT=8989
GRAPHHOPPER_URL=http://localhost:8989
# GRAPHHOPPER_API_KEY=
# GRAPHHOPPER_NATIVE_RESCUE=false

MAPY_API_KEY=your_mapy_api_key_here
USE_MAPY_TILES=false

# Weather map = Open-Meteo (https://github.com/open-meteo/weather-map-layer).
# Free + key-less; the backend caches the .om byte-ranges. No API key required.
# Optional cache tuning (ms / bytes):
# OM_JSON_TTL_MS=180000
# OM_TTL_MS=7200000
# OM_CACHE_MAX_BYTES=268435456

# ── Push-to-talk bridges ─────────────────────────────────────────────────────
# Optional. The dashboard's Settings page stores these in the database instead;
# the environment is for deployments that would rather not keep the bot
# credentials there, and it lets a fresh install connect with no clicks.
# ZELLO_WS_URL=wss://zello.io/ws
# Comma-separated list of channels the bot can reach; the first is joined by
# default (only one channel can be joined per connection).
# ZELLO_CHANNELS=Test integration channel
# ZELLO_CHANNEL=Test integration channel
# ZELLO_IGNORED_CHANNELS=
# ZELLO_USERNAME=
# ZELLO_PASSWORD=
# Either a ready-made developer token, or an issuer + RSA private key to mint
# one on every connect (the key may be inline or a file path).
# ZELLO_DEV_TOKEN=
# ZELLO_ISSUER=
# Inline PEM (escaped \n accepted) or, locally, a path to the .pem file.
# ZELLO_PRIVATE_KEY=
# ZELLO_PRIVATE_KEY_PATH=./zello-private-key.pem
# Set to "false" to keep an env-configured bridge from connecting on boot.
# ZELLO_ENABLED=true

EXPO_PUBLIC_API_URL=http://localhost:8500/api
EXPO_PUBLIC_WS_URL=http://localhost:8500/realtime
EXPO_PUBLIC_MAPY_API_KEY=your_mapy_api_key_here
